[Unit]
Description=Not Armory Crate Aura Sync service
Documentation=file://@PREFIX@/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=org.armorycrate.Aura1
ExecStart=/usr/bin/python3 -m armory_crate daemon
Environment=PYTHONPATH=@PREFIX@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
