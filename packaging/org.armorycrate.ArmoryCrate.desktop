[Desktop Entry]
Type=Application
Name=Not Armory Crate
Comment=System monitor and Aura Sync lighting for ASUS ROG hardware
Exec=env PYTHONPATH=@PREFIX@ /usr/bin/python3 -m armory_crate gui
Icon=org.armorycrate.ArmoryCrate
